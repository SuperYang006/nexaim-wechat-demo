{
  "name": "nexaim-wechat-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:sdk": "node scripts/bundle-sdk.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "pnpm build && pnpm build:server && pnpm typecheck && pnpm test && pnpm test:miniapp",
    "dev:server": "node --env-file-if-exists=.env --import tsx server/src/index.ts",
    "test:miniapp": "node scripts/check-miniapp.mjs",
    "build:server": "node scripts/build-server.mjs",
    "start:server": "node dist/server/index.mjs",
    "configure": "node scripts/configure.mjs",
    "sdk:update": "node scripts/update-sdk.mjs",
    "package:demo": "node scripts/package-demo.mjs"
  },
  "dependencies": {
    "fastify": "^5.0.0",
    "zod": "^3.23.0",
    "js-sha256": "^0.11.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "miniprogram-api-typings": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.1.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
