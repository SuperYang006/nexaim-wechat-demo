# 仅业务服务端读取。复制为 .env 后填写；不要放进 miniprogram/。
PORT=3100
HOST=127.0.0.1
WECHAT_APP_ID=wx0000000000000000
WECHAT_APP_SECRET=
# 下列为已部署的 NexaIM 公网地址；业务服务端和小程序均需可达。
NEXAIM_API_BASE_URL=https://api.nexaims.com
NEXAIM_WS_BASE_URL=wss://ws.nexaims.com/ws
# NexaIM Console 中的应用 UUID，与微信 AppID 不同。
NEXAIM_APP_ID=
NEXAIM_APP_KEY=
NEXAIM_APP_SECRET=
# 仅同机部署模板使用；独立部署不用此项。
NEXAIM_DOCKER_NETWORK=nexaim_default

# 独立部署：本机反向代理连接的 HTTP 端口，仅绑定 127.0.0.1。
BUSINESS_HTTP_PORT=3100
