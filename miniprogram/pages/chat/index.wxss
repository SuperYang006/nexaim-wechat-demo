.chat-page{height:100vh;display:flex;flex-direction:column}.chat-header{padding:20rpx 24rpx;background:var(--surface);display:flex;align-items:center;flex-wrap:wrap;gap:12rpx}.chat-header .peer{font-size:20rpx;width:100%;word-break:break-all}.chat-header button{margin:0}.message-list{flex:1;min-height:0;height:0}.chat-error{margin:12rpx 24rpx;font-size:24rpx}.read-action{text-align:center;padding:24rpx}.read-action button{color:var(--muted);background:transparent}.upload-state{padding:16rpx 24rpx;font-size:24rpx;color:var(--muted);background:var(--surface)}.upload-state button{margin-right:16rpx}.safe-bottom{height:env(safe-area-inset-bottom);background:var(--surface)}
