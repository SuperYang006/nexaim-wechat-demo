.account{display:flex;align-items:center;flex-wrap:wrap;gap:12rpx;margin:24rpx 0}.account text{width:100%;font-size:22rpx;word-break:break-all}.account button{margin:0}.start-chat{display:flex;gap:16rpx;align-items:center;padding:24rpx}.start-chat input{flex:1;min-width:0;font-size:26rpx}.section{display:flex;align-items:center;justify-content:space-between;margin:36rpx 0 16rpx}.section button{margin:0}.conversation{display:flex;align-items:center;padding:28rpx 0;border-bottom:1rpx solid var(--border);gap:20rpx}.avatar{width:76rpx;height:76rpx;line-height:76rpx;text-align:center;background:var(--accent-soft);color:var(--accent);border-radius:20rpx}.conversation-body{flex:1;min-width:0}.peer{font-size:26rpx;margin-bottom:10rpx}.conversation-meta{text-align:right}.time{font-size:20rpx;color:var(--muted)}.badge{background:var(--accent);color:var(--surface);border-radius:24rpx;padding:2rpx 12rpx;margin-top:12rpx;display:inline-block}
