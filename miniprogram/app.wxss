page{--background:#f4f6f8;--surface:#fff;--text:#182b38;--muted:#6b7b88;--accent:#087f73;--accent-soft:#dff2eb;--border:#e1e7eb;--danger:#bb3e3e;background:var(--background);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;font-size:28rpx}.page{padding:32rpx}.card{background:var(--surface);padding:36rpx;border-radius:24rpx}.title{font-size:40rpx;font-weight:600}.muted{color:var(--muted);line-height:1.7}.primary{background:var(--accent)!important;color:var(--surface)!important}.primary[disabled]{opacity:.45}.error{color:var(--danger);background:var(--surface);padding:20rpx;border-radius:12rpx;margin:20rpx 0;word-break:break-word}.notice{padding:24rpx;border-radius:12rpx;background:var(--background);color:var(--muted);line-height:1.7}.empty{padding:80rpx 24rpx;text-align:center;color:var(--muted);line-height:1.8}.ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}button::after{border:none}button{font-size:28rpx;border-radius:12rpx}button[size=mini]{font-size:24rpx}
