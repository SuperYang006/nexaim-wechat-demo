.message{display:flex;flex-direction:column;align-items:flex-start;margin:24rpx}.mine{align-items:flex-end}.bubble{max-width:82%;padding:20rpx 24rpx;border-radius:18rpx;background:var(--surface);word-break:break-word;font-size:28rpx;line-height:1.6}.mine .bubble{background:var(--accent-soft)}.bubble image{width:360rpx;max-width:100%;display:block;border-radius:10rpx}.status{font-size:22rpx;color:var(--muted);margin-top:10rpx}.retry{color:var(--accent)}
